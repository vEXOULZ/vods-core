{
  "name": "@vexoulz/vods-core",
  "version": "0.18.0",
  "private": true,
  "type": "module",
  "description": "The vods sites' engine and app: archive API client, part/restricted time math, YouTube player control, chat replay, watch progress, and (in ./app) the pages, Manage dashboard and router every vods site shares",
  "repository": "github:vEXOULZ/vods-core",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vue": {
      "types": "./dist/types/vue/index.d.ts",
      "import": "./dist/vue.js"
    },
    "./app": {
      "types": "./dist/types/app/index.d.ts",
      "import": "./dist/app.js"
    },
    "./app.css": "./dist/app.css",
    "./kit": {
      "types": "./dist/types/app/kit.d.ts",
      "import": "./dist/kit.js"
    },
    "./dev": {
      "types": "./dist/types/dev/adminMock.d.ts",
      "import": "./dist/dev.js"
    }
  },
  "scripts": {
    "build": "vite build && vue-tsc -p tsconfig.build.json",
    "typecheck": "vue-tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "fixtures": "node scripts/fetch-fixtures.mjs",
    "prepare": "npm run build",
    "changeset": "changeset",
    "release": "changeset version"
  },
  "peerDependencies": {
    "@vexoulz/ui": "*",
    "vite": "^7.0.0",
    "vue": "^3.5.43",
    "vue-router": "^4.6.4"
  },
  "peerDependenciesMeta": {
    "@vexoulz/ui": {
      "optional": true
    },
    "vite": {
      "optional": true
    },
    "vue": {
      "optional": true
    },
    "vue-router": {
      "optional": true
    }
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/node": "^22.20.5",
    "@vexoulz/ui": "github:vEXOULZ/vexoulz-ui#v0.17.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "happy-dom": "^20.14.5",
    "typescript": "~5.9.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.11",
    "vue": "^3.5.43",
    "vue-router": "^4.6.4",
    "vue-tsc": "^3.3.11"
  },
  "dependencies": {
    "@vexoulz/platform-web": "github:vEXOULZ/vex-platform-web#v0.3.0"
  },
  "engines": {
    "node": ">=22"
  }
}
